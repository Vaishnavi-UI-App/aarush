// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenants & users
// ---------------------------------------------------------------------------

model Tenant {
  id             String   @id @default(uuid())
  name           String
  gstin          String
  pan            String?
  stateCode      String // 2-digit GST state code, e.g. "27" for Maharashtra
  invoicePrefix  String   @default("INV")
  addressLine    String?
  phone          String?
  email          String?
  logoUrl        String?  @default("/logo.jpeg")

  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  bankName        String?
  bankBranch      String?

  invoiceTerms String? // one line per entry, shown as Terms & Conditions on the invoice PDF

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        User[]
  customers    Customer[]
  vendors      Vendor[]
  items        Item[]
  invoices     Invoice[]
  purchases    Purchase[]
  payments     Payment[]
  vendorPayments VendorPayment[]
  ledgerEntries LedgerEntry[]
  invoiceCounters InvoiceCounter[]
  purchaseCounters PurchaseCounter[]
  bankAccounts BankAccount[]
  deliveryChallans DeliveryChallan[]
  deliveryChallanCounters DeliveryChallanCounter[]
  attendanceRecords AttendanceRecord[]
  sites            Site[]
  fundAllocations  FundAllocation[]
  expenseCategories ExpenseCategory[]
  orderedByPeople  OrderedByPerson[]
  expenses         Expense[]
  locationPings    LocationPing[]
  rolePermissions  RolePermission[]

  @@map("tenants")
}

enum UserRole {
  OWNER
  ACCOUNTANT
  SALES_STAFF
  AUDITOR
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String?
  email     String   @unique
  passwordHash String
  role      UserRole @default(SALES_STAFF)
  createdAt DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  attendanceRecords   AttendanceRecord[]
  fundAllocationsAdded FundAllocation[] @relation("FundAllocationsAdded")
  expensesAdded        Expense[]        @relation("ExpensesAdded")
  locationPing         LocationPing?

  @@index([tenantId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model AttendanceRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  date     DateTime @db.Date

  checkInAt        DateTime?
  checkInLat       Decimal?  @db.Decimal(9, 6)
  checkInLng       Decimal?  @db.Decimal(9, 6)
  checkInPhotoData String?   @db.Text

  checkOutAt       DateTime?
  checkOutLat      Decimal?  @db.Decimal(9, 6)
  checkOutLng      Decimal?  @db.Decimal(9, 6)
  checkOutPhotoData String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Masters
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  gstin       String?
  stateCode   String
  address     String?
  email       String?
  phone       String?
  creditLimit Decimal? @db.Decimal(14, 2)
  creditDays  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  deliveryChallans DeliveryChallan[]

  @@index([tenantId])
  @@map("customers")
}

model Vendor {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  gstin     String?
  stateCode String
  address   String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases     Purchase[]
  vendorPayments VendorPayment[]
  ledgerEntries LedgerEntry[]

  @@index([tenantId])
  @@map("vendors")
}

model Item {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  hsnCode       String
  unit          String
  salePrice     Decimal  @db.Decimal(14, 2)
  purchasePrice Decimal? @db.Decimal(14, 2)
  taxRate       Decimal  @db.Decimal(5, 2) // e.g. 18.00 for 18%
  currentStock  Decimal  @default(0) @db.Decimal(12, 3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoiceLines  InvoiceLine[]
  purchaseLines PurchaseLine[]

  @@index([tenantId])
  @@map("items")
}

// ---------------------------------------------------------------------------
// Invoice numbering (per tenant, per financial year)
// ---------------------------------------------------------------------------

model InvoiceCounter {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  financialYear  String // e.g. "26-27"
  type           InvoiceType @default(SALE)
  lastSequence   Int         @default(0)

  @@unique([tenantId, financialYear, type])
  @@map("invoice_counters")
}

// ---------------------------------------------------------------------------
// Delivery Challans
// ---------------------------------------------------------------------------

model DeliveryChallanCounter {
  id            String @id @default(uuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  financialYear String // e.g. "26-27"
  lastSequence  Int    @default(0)

  @@unique([tenantId, financialYear])
  @@map("delivery_challan_counters")
}

model DeliveryChallan {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  number        String
  date          DateTime @default(now())
  toName        String?
  toAddress     String?
  poNumber      String?
  poDate        DateTime?
  vehicleNumber String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  archivedAt DateTime?

  lines DeliveryChallanLine[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId])
  @@map("delivery_challans")
}

model DeliveryChallanLine {
  id          String          @id @default(uuid())
  challanId   String
  challan     DeliveryChallan @relation(fields: [challanId], references: [id])
  srNo        Int
  particulars String
  qty         Decimal         @db.Decimal(12, 3)

  @@map("delivery_challan_lines")
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceType {
  SALE
  PROFORMA
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  APPROVED
}

model Invoice {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])

  type       InvoiceType   @default(SALE)
  number     String // fully formatted, e.g. "INV/26-27/439"
  date       DateTime      @default(now())
  dueDate    DateTime?
  status     InvoiceStatus @default(DRAFT)

  subtotal   Decimal @db.Decimal(14, 2)
  discount   Decimal @db.Decimal(14, 2) @default(0)
  cgst       Decimal @db.Decimal(14, 2) @default(0)
  sgst       Decimal @db.Decimal(14, 2) @default(0)
  igst       Decimal @db.Decimal(14, 2) @default(0)
  roundOff   Decimal @db.Decimal(14, 2) @default(0)
  total      Decimal @db.Decimal(14, 2)

  // Dispatch details -- entered per invoice at creation time, since they vary shipment
  // to shipment (unlike the tenant/customer master data).
  poNumber           String?
  poDate             DateTime?
  vehicleNumber      String?
  transportationMode String?
  reverseCharge      Boolean   @default(false)
  deliveredThrough   String?
  placeOfSupplySite  String?

  // Consignee (ship-to) details. Defaults to the billing customer's own address, but a
  // customer may want goods delivered to a different site -- e.g. a head office that's
  // billed but a job site that receives the goods.
  shipToSameAsBilling Boolean @default(true)
  shipToName          String?
  shipToAddress       String?
  shipToGstin         String?
  shipToStateCode     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  archivedAt DateTime? // soft-delete: archived invoices are hidden from the main list but never destroyed, and can be restored

  // Set on a PROFORMA once it's been converted to a real SALE invoice -- lets the
  // proforma row link forward to what it became instead of just showing "cancelled".
  convertedToInvoiceId  String?  @unique
  convertedToInvoice    Invoice? @relation("ProformaConversion", fields: [convertedToInvoiceId], references: [id])
  convertedFromProforma Invoice? @relation("ProformaConversion")

  // Internal remark entered when converting a proforma to this sale invoice. Never shown
  // on the printed PDF or in customer emails/WhatsApp -- OWNER-only in the app UI.
  conversionNote String?

  lines         InvoiceLine[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @default(uuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  itemId        String?
  item          Item?   @relation(fields: [itemId], references: [id])

  description   String
  hsnCode       String
  qty           Decimal @db.Decimal(12, 3)
  rate          Decimal @db.Decimal(14, 2)
  taxableValue  Decimal @db.Decimal(14, 2)
  taxRate       Decimal @db.Decimal(5, 2)
  cgstAmount    Decimal @db.Decimal(14, 2) @default(0)
  sgstAmount    Decimal @db.Decimal(14, 2) @default(0)
  igstAmount    Decimal @db.Decimal(14, 2) @default(0)
  lineTotal     Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// Purchases (vendor side, mirrors Invoice)
// ---------------------------------------------------------------------------

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model PurchaseCounter {
  id            String @id @default(uuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  financialYear String
  lastSequence  Int    @default(0)

  @@unique([tenantId, financialYear])
  @@map("purchase_counters")
}

model Purchase {
  id       String         @id @default(uuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  vendorId String
  vendor   Vendor         @relation(fields: [vendorId], references: [id])

  number   String // our internal number, e.g. "PB/26-27/1"
  vendorBillNumber String? // the vendor's own bill/invoice number, for 3-way matching
  date     DateTime       @default(now())
  dueDate  DateTime?
  status   PurchaseStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(14, 2)
  discount Decimal @db.Decimal(14, 2) @default(0)
  cgst     Decimal @db.Decimal(14, 2) @default(0)
  sgst     Decimal @db.Decimal(14, 2) @default(0)
  igst     Decimal @db.Decimal(14, 2) @default(0)
  total    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime? // soft-delete: archived bills are hidden from the main list but never destroyed, and can be restored

  lines         PurchaseLine[]
  vendorPayments VendorPayment[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, number])
  @@index([tenantId, vendorId])
  @@map("purchases")
}

model PurchaseLine {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  itemId     String?
  item       Item?    @relation(fields: [itemId], references: [id])

  description  String
  hsnCode      String
  qty          Decimal @db.Decimal(12, 3)
  rate         Decimal @db.Decimal(14, 2)
  taxableValue Decimal @db.Decimal(14, 2)
  taxRate      Decimal @db.Decimal(5, 2)
  cgstAmount   Decimal @db.Decimal(14, 2) @default(0)
  sgstAmount   Decimal @db.Decimal(14, 2) @default(0)
  igstAmount   Decimal @db.Decimal(14, 2) @default(0)
  lineTotal    Decimal @db.Decimal(14, 2)

  @@index([purchaseId])
  @@map("purchase_lines")
}

// Money we pay OUT to a vendor (distinct from Payment, which is money customers pay us).
model VendorPayment {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  vendorId   String
  vendor     Vendor        @relation(fields: [vendorId], references: [id])
  purchaseId String?
  purchase   Purchase?     @relation(fields: [purchaseId], references: [id])

  amount      Decimal       @db.Decimal(14, 2)
  mode        PaymentMode
  status      PaymentStatus @default(SUCCESS)
  referenceNo String?
  date        DateTime      @default(now())

  createdAt DateTime @default(now())

  ledgerEntries LedgerEntry[]
  bankTransaction BankTransaction?

  @@index([tenantId, vendorId])
  @@map("vendor_payments")
}

// ---------------------------------------------------------------------------
// Banking
// ---------------------------------------------------------------------------

model BankAccount {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  bankName       String
  accountNo      String
  ifsc           String
  branchName     String?
  openingBalance Decimal  @db.Decimal(14, 2) @default(0)
  createdAt      DateTime @default(now())

  transactions BankTransaction[]

  @@index([tenantId])
  @@map("bank_accounts")
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
}

model BankTransaction {
  id            String              @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  description   String
  amount        Decimal             @db.Decimal(14, 2)
  type          BankTransactionType
  matchStatus   BankMatchStatus     @default(UNMATCHED)

  matchedPaymentId String?  @unique
  matchedPayment   Payment? @relation(fields: [matchedPaymentId], references: [id])
  matchedVendorPaymentId String? @unique
  matchedVendorPayment   VendorPayment? @relation(fields: [matchedVendorPaymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([bankAccountId, date])
  @@map("bank_transactions")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  RAZORPAY
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  invoiceId  String?
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])

  amount        Decimal       @db.Decimal(14, 2)
  mode          PaymentMode
  status        PaymentStatus @default(PENDING)
  referenceNo   String?
  date          DateTime      @default(now())

  // Razorpay specific fields
  razorpayPaymentLinkId String? @unique
  razorpayPaymentId     String? @unique
  razorpayOrderId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  bankTransaction BankTransaction?

  @@index([tenantId, customerId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Append-only ledger. Never UPDATE or DELETE rows in this table -- corrections
// are modeled as new offsetting entries. See README "Ledger conventions".
// ---------------------------------------------------------------------------

enum LedgerPartyType {
  CUSTOMER
  VENDOR
}

enum LedgerRefType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  OPENING_BALANCE
  ADJUSTMENT
  PURCHASE
  VENDOR_PAYMENT
}

model LedgerEntry {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  partyType LedgerPartyType
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])

  refType         LedgerRefType
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  purchaseId      String?
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id])
  vendorPaymentId String?
  vendorPayment   VendorPayment? @relation(fields: [vendorPaymentId], references: [id])

  // For a customer: debit increases what the customer owes us (invoice raised),
  // credit decreases it (payment received). For a vendor: debit increases what we
  // owe the vendor (a bill received), credit decreases it (a payment we made).
  // Either way, runningBalance = SUM(debit) - SUM(credit) for that party.
  debit  Decimal @db.Decimal(14, 2) @default(0)
  credit Decimal @db.Decimal(14, 2) @default(0)

  runningBalance Decimal @db.Decimal(14, 2)

  description String
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, vendorId, createdAt])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Expenses -- per-site wallets funding company vs. personal spend
// ---------------------------------------------------------------------------

model Site {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  address    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // soft-delete, same convention as Invoice/Purchase/DeliveryChallan

  wallet          SiteWallet?
  fundAllocations FundAllocation[]
  expenses        Expense[]

  @@index([tenantId])
  @@map("sites")
}

model SiteWallet {
  id     String @id @default(uuid())
  siteId String @unique
  site   Site   @relation(fields: [siteId], references: [id])
  // No own tenantId -- a 1:1 derived-state child of Site, scoped entirely through it
  // (same as InvoiceLine having no tenantId of its own).

  companyBalance          Decimal  @db.Decimal(14, 2) @default(0)
  totalFundsReceived      Decimal  @db.Decimal(14, 2) @default(0)
  totalCompanySpent       Decimal  @db.Decimal(14, 2) @default(0)
  totalPersonalSpent      Decimal  @db.Decimal(14, 2) @default(0)
  totalPersonalReimbursed Decimal  @db.Decimal(14, 2) @default(0)
  updatedAt               DateTime @updatedAt

  @@map("site_wallets")
}

model FundAllocation {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  siteId   String
  site     Site   @relation(fields: [siteId], references: [id])

  amount               Decimal  @db.Decimal(14, 2)
  reimbursedToPersonal Decimal  @db.Decimal(14, 2) @default(0)
  addedToBalance       Decimal  @db.Decimal(14, 2) @default(0)
  note      String?
  addedById String
  addedBy   User     @relation("FundAllocationsAdded", fields: [addedById], references: [id])
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tenantId, siteId])
  @@map("fund_allocations")
}

enum ExpenseFundType {
  COMPANY
  PERSONAL
  SPLIT
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model OrderedByPerson {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@unique([tenantId, name])
  @@map("ordered_by_people")
}

model Expense {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  siteId   String
  site     Site   @relation(fields: [siteId], references: [id])

  categoryId  String?
  category    ExpenseCategory?  @relation(fields: [categoryId], references: [id])
  orderedById String?
  orderedBy   OrderedByPerson?  @relation(fields: [orderedById], references: [id])

  amount           Decimal         @db.Decimal(14, 2)
  companyPaid      Decimal         @db.Decimal(14, 2) @default(0)
  personalPaid     Decimal         @db.Decimal(14, 2) @default(0)
  fundType         ExpenseFundType // always server-derived, never client-supplied
  date             DateTime        @default(now())
  note             String?
  receiptPhotoData String?         @db.Text // same data-URL convention as attendance photos

  addedById String
  addedBy   User     @relation("ExpensesAdded", fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@index([tenantId, siteId])
  @@index([tenantId, addedById])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Live location tracking -- last-known position while the app is open
// ---------------------------------------------------------------------------

model LocationPing {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  userId   String   @unique // one row per user -- latest position only, not a history log
  user     User     @relation(fields: [userId], references: [id])
  lat      Decimal  @db.Decimal(9, 6)
  lng      Decimal  @db.Decimal(9, 6)
  pingedAt DateTime @default(now())

  @@index([tenantId])
  @@map("location_pings")
}

// ---------------------------------------------------------------------------
// Configurable per-role permissions -- a row here overrides the hardcoded default
// in src/lib/permissions.ts; absence of a row means "use the default".
// ---------------------------------------------------------------------------

model RolePermission {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  role     UserRole
  key      String
  allowed  Boolean

  @@unique([tenantId, role, key])
  @@map("role_permissions")
}
