# Copy this file to .env (Prisma/scripts) and .env.local (Next.js) and fill in real values.
# Never commit .env or .env.local -- both are gitignored.

# PostgreSQL (docker compose up -d starts a local instance on port 5433)
DATABASE_URL="postgresql://arush:arush_dev_password@localhost:5433/arush_billing?schema=public"

# Session signing secret for the dev session cookie -- generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Razorpay (https://dashboard.razorpay.com -- use test mode keys for development)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set in Razorpay Dashboard -> Settings -> Webhooks when you create the webhook,
# then paste the same value here.
RAZORPAY_WEBHOOK_SECRET=""
APP_BASE_URL="http://localhost:3000"

# Email sending via SMTP (e.g. Gmail with a 2FA App Password: myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Aarush Fire Protection Systems <your@gmail.com>"

# WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Production only (docker-compose.prod.yml) -- Postgres container password and the
# domain Caddy requests/renews a Let's Encrypt certificate for.
POSTGRES_PASSWORD=""
DOMAIN=""
